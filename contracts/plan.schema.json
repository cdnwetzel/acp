{
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "criterion", "deps"],
        "properties": {
          "id": { "type": "string", "pattern": "^TASK-[0-9]+$" },
          "criterion": { "type": "string", "minLength": 1 },
          "deps": {
            "type": "array",
            "items": { "type": "string", "pattern": "^TASK-[0-9]+$" }
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
