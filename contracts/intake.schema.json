{
  "type": "object",
  "required": [
    "problem",
    "constraints",
    "acceptance_criteria",
    "required_imports"
  ],
  "properties": {
    "problem": {
      "type": "string",
      "minLength": 10
    },
    "constraints": {
      "type": "array",
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1
    },
    "required_imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "from"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
          }
        }
      }
    }
  }
}
