{
  "type": "object",
  "required": ["record_type", "run_id", "ledger_head", "ts"],
  "properties": {
    "record_type": { "type": "string", "pattern": "^(run_manifest|worker_call|gate)$" },
    "run_id": { "type": "string", "minLength": 8 },
    "ledger_head": { "type": "string", "minLength": 8 },
    "ts": { "type": "string", "minLength": 10 },
    "phase": { "type": "string", "pattern": "^(intake|plan|code|review|test|verify|validate)$" },
    "task_id": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "planned_capability": { "type": "string", "minLength": 1 },
    "invoked_capability": { "type": "string", "minLength": 1 },
    "model": { "type": "string" },
    "provider": { "type": "string" },
    "endpoint": { "type": "string" },
    "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "command": { "type": "string" },
    "exit_status": { "type": "integer" },
    "duration_s": { "type": "number" },
    "budgets": { "type": "object" },
    "artifact_hashes": { "type": "object" },
    "gate_result": { "type": "string", "pattern": "^(pass|fail)$" },
    "limitations": { "type": "array" },
    "runtime": { "type": "string" },
    "iso_config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pxx_session_id": { "type": "string", "minLength": 1 },
    "payload_mode_expected": { "type": "string", "pattern": "^(bare|default)$" },
    "payload_mode": { "type": "string", "minLength": 1 },
    "system_message_present": { "type": "boolean" },
    "tools_key_present": { "type": "boolean" },
    "tool_count": { "type": "integer" },
    "declared_workers": { "type": "object" },
    "detail": { "type": "string" }
  }
}
