<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- ACP governed-endpoint forward: MacBook -> T5810 labrouter :8004.
       Supervision is OPERATOR INFRASTRUCTURE, outside the runner: the
       pipeline still never starts the forward itself (check_access fails
       closed when it is down). launchd merely keeps the operator-sanctioned
       forward alive across drops (3 unsupervised deaths on 2026-10-04).
       Runs in the user domain (requires the owner logged in). -->
  <key>Label</key>
  <string>local.acp.forward-8004</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-L</string>
    <string>8004:127.0.0.1:8004</string>
    <string>-o</string>
    <string>ServerAliveInterval=15</string>
    <string>-o</string>
    <string>ServerAliveCountMax=3</string>
    <string>-o</string>
    <string>BatchMode=yes</string>
    <string>-o</string>
    <string>ExitOnForwardFailure=yes</string>
    <string>chris@10.0.1.125</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/cwetzel/Library/Logs/acp-forward-8004.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/cwetzel/Library/Logs/acp-forward-8004.log</string>
</dict>
</plist>
